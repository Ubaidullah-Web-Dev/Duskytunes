_systemd_users() {
  loginctl list-users --no-legend 2>/dev/null | awk '{print $1}'
}

post_install() {
  for uid in $(_systemd_users); do
    systemctl --user -M "$uid@" daemon-reload 2>/dev/null || true
    systemctl --user -M "$uid@" enable --now duskytunesd.socket 2>/dev/null || true
  done
}

post_upgrade() {
  post_install
}

pre_remove() {
  for uid in $(_systemd_users); do
    systemctl --user -M "$uid@" stop duskytunesd.socket duskytunesd.service 2>/dev/null || true
    systemctl --user -M "$uid@" disable duskytunesd.socket 2>/dev/null || true
  done
}

post_remove() {
  for uid in $(_systemd_users); do
    systemctl --user -M "$uid@" daemon-reload 2>/dev/null || true
  done
}
