# Local-source PKGBUILD for Duskytunes.
# Run from packaging/arch with: makepkg -si

pkgname=duskytunes
pkgver=1.2.5
pkgrel=1
epoch=1
pkgdesc="Dusky desktop music player — discover, stream, and enjoy your music collection"
url='https://github.com/Ubaidullah-Web-Dev/Duskytunes'
arch=('x86_64')
license=('GPL-3.0-or-later')
provides=('duskytunes' 'ryotunes=1.2.5')
conflicts=('ryotunes')
replaces=('ryotunes')
depends=(
  'webkit2gtk-4.1'
  'libappindicator-gtk3'
  'mpv'
  'yt-dlp'
  'ffmpeg'
  'openssl'
  'librsvg'
  'desktop-file-utils'
  'hicolor-icon-theme'
  'xdg-utils'
  'polkit'
  'quickshell'
)
makedepends=(
  'base-devel'
  'cargo'
  'nodejs'
  'pnpm'
  'appmenu-gtk-module'
  'xdotool'
)
install=duskytunes.install
options=(!lto !debug)
source=()
sha256sums=()

prepare() {
  local root
  root="$(cd "$startdir/../.." && pwd)"
  rm -rf "$srcdir/duskytunes"
  mkdir -p "$srcdir/duskytunes"
  tar \
    --exclude='.git' \
    --exclude='target' \
    --exclude='ui/node_modules' \
    --exclude='ui/build' \
    --exclude='ui/.svelte-kit' \
    --exclude='./packaging/arch/pkg' \
    --exclude='./packaging/arch/src' \
    --exclude='./packaging/arch/*.pkg.tar.*' \
    -C "$root" -cf - . | tar -C "$srcdir/duskytunes" -xf -
}

build() {
  cd "$srcdir/duskytunes/ui"
  if command -v pnpm >/dev/null 2>&1; then
    pnpm install --frozen-lockfile
    pnpm build
  fi

  cd "$srcdir/duskytunes"
  cargo build --release --locked --package ryotunes --package sync-server --package ryotunesd --package ryotunes-cli
}

check() {
  cd "$srcdir/duskytunes"
  cargo test --workspace --locked
}

package() {
  cd "$srcdir/duskytunes"
  local binaries="${CARGO_TARGET_DIR:-target}/release"
  
  # Binaries (both duskytunes and ryotunes names)
  if [[ -f "$binaries/duskytunes" ]]; then
    install -Dm755 "$binaries/duskytunes" "$pkgdir/usr/bin/duskytunes"
  elif [[ -f "$binaries/ryotunes" ]]; then
    install -Dm755 "$binaries/ryotunes" "$pkgdir/usr/bin/duskytunes"
  fi
  ln -sf duskytunes "$pkgdir/usr/bin/ryotunes"

  if [[ -f "$binaries/duskytunesd" ]]; then
    install -Dm755 "$binaries/duskytunesd" "$pkgdir/usr/bin/duskytunesd"
  elif [[ -f "$binaries/ryotunesd" ]]; then
    install -Dm755 "$binaries/ryotunesd" "$pkgdir/usr/bin/duskytunesd"
  fi
  ln -sf duskytunesd "$pkgdir/usr/bin/ryotunesd"

  if [[ -f "$binaries/duskytunes-cli" ]]; then
    install -Dm755 "$binaries/duskytunes-cli" "$pkgdir/usr/bin/duskytunes-cli"
  elif [[ -f "$binaries/ryotunes-cli" ]]; then
    install -Dm755 "$binaries/ryotunes-cli" "$pkgdir/usr/bin/duskytunes-cli"
  fi
  ln -sf duskytunes-cli "$pkgdir/usr/bin/ryotunes-cli"

  if [[ -f "$binaries/ryotunes-sync" ]]; then
    install -Dm755 "$binaries/ryotunes-sync" "$pkgdir/usr/bin/duskytunes-sync"
    ln -sf duskytunes-sync "$pkgdir/usr/bin/ryotunes-sync"
  fi

  install -Dm755 packaging/linux/duskytunes-qml "$pkgdir/usr/bin/duskytunes-qml"
  ln -sf duskytunes-qml "$pkgdir/usr/bin/ryotunes-qml"

  install -Dm755 scripts/diagnostics.sh "$pkgdir/usr/bin/duskytunes-diagnostics"
  ln -sf duskytunes-diagnostics "$pkgdir/usr/bin/ryotunes-diagnostics"

  # Native QML client
  install -dm755 "$pkgdir/usr/share/duskytunes"
  cp -r client "$pkgdir/usr/share/duskytunes/client"
  rm -rf "$pkgdir/usr/share/duskytunes/client/tests"
  find "$pkgdir/usr/share/duskytunes/client" -type d -exec chmod 755 {} +
  find "$pkgdir/usr/share/duskytunes/client" -type f -exec chmod 644 {} +
  ln -sf /usr/share/duskytunes "$pkgdir/usr/share/ryotunes"

  # Shipped skins and matugen template
  install -dm755 "$pkgdir/usr/share/duskytunes/skins"
  cp -r skins/. "$pkgdir/usr/share/duskytunes/skins/"
  find "$pkgdir/usr/share/duskytunes/skins" -type d -exec chmod 755 {} +
  find "$pkgdir/usr/share/duskytunes/skins" -type f -exec chmod 644 {} +
  install -Dm644 matugen/ryotunes.json "$pkgdir/usr/share/duskytunes/matugen/duskytunes.json"

  # Bundled Ryoku.Ui design runtime
  if [[ -d "runtime/qml/Ryoku/Ui" ]]; then
    install -dm755 "$pkgdir/usr/lib/qt6/qml/Ryoku/Ui"
    cp -r runtime/qml/Ryoku/Ui/. "$pkgdir/usr/lib/qt6/qml/Ryoku/Ui/"
    find "$pkgdir/usr/lib/qt6/qml/Ryoku/Ui" -type d -exec chmod 755 {} +
    find "$pkgdir/usr/lib/qt6/qml/Ryoku/Ui" -type f -exec chmod 644 {} +
  fi

  # Systemd user units
  install -Dm644 packaging/linux/duskytunesd.socket "$pkgdir/usr/lib/systemd/user/duskytunesd.socket"
  install -Dm644 packaging/linux/duskytunesd.service "$pkgdir/usr/lib/systemd/user/duskytunesd.service"
  install -Dm644 packaging/linux/90-duskytunes.preset "$pkgdir/usr/lib/systemd/user-preset/90-duskytunes.preset"

  # Desktop entries & metainfo
  install -Dm644 packaging/linux/duskytunes.desktop "$pkgdir/usr/share/applications/duskytunes.desktop"
  ln -sf duskytunes.desktop "$pkgdir/usr/share/applications/ryotunes.desktop"

  # Icons
  for s in 32x32 64x64 128x128; do
    install -Dm644 "src-tauri/icons/${s}.png" "$pkgdir/usr/share/icons/hicolor/${s}/apps/duskytunes.png"
    ln -sf duskytunes.png "$pkgdir/usr/share/icons/hicolor/${s}/apps/ryotunes.png"
  done
  install -Dm644 src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/duskytunes.png"
  ln -sf duskytunes.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/ryotunes.png"
  install -Dm644 src-tauri/icons/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/duskytunes.png"
  ln -sf duskytunes.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/ryotunes.png"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/duskytunes/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/duskytunes/README.md"
}
