# Maintainer: Ubaid <ubaidullah.web.dev@gmail.com>
pkgname=duskytunes
pkgver=1.0.0
pkgrel=1
epoch=1
pkgdesc="Duskytunes — The modern desktop music player for Dusky and Linux"
arch=('x86_64')
url="https://github.com/Ubaidullah-Web-Dev/Duskytunes"
license=('GPL-3.0-or-later')
depends=(
  'quickshell'
  'mpv'
  'yt-dlp'
  'ffmpeg'
  'openssl'
  'desktop-file-utils'
  'hicolor-icon-theme'
  'xdg-utils'
  'polkit'
)
makedepends=('git')
provides=('duskytunes')
conflicts=('duskytunes')
replaces=('duskytunes')
install=duskytunes.install

package() {
  cd "$srcdir/.."

  # Check prebuilt binaries first, fallback to cargo target
  local binaries="bin/x86_64"
  if [[ ! -d "$binaries" && -d "target/release" ]]; then
    binaries="target/release"
  fi

  # Binaries
  if [[ -f "$binaries/duskytunes" ]]; then
    install -Dm755 "$binaries/duskytunes" "$pkgdir/usr/bin/duskytunes"
  fi
  if [[ -f "$binaries/duskytunesd" ]]; then
    install -Dm755 "$binaries/duskytunesd" "$pkgdir/usr/bin/duskytunesd"
  fi
  if [[ -f "$binaries/duskytunes-cli" ]]; then
    install -Dm755 "$binaries/duskytunes-cli" "$pkgdir/usr/bin/duskytunes-cli"
  fi
  if [[ -f "$binaries/duskytunes-sync" ]]; then
    install -Dm755 "$binaries/duskytunes-sync" "$pkgdir/usr/bin/duskytunes-sync"
  fi

  # Native QML launcher and diagnostics
  install -Dm755 packaging/linux/duskytunes-qml "$pkgdir/usr/bin/duskytunes-qml"
  install -Dm755 scripts/diagnostics.sh "$pkgdir/usr/bin/duskytunes-diagnostics"

  # Systemd user services
  install -Dm644 packaging/linux/duskytunesd.service "$pkgdir/usr/lib/systemd/user/duskytunesd.service"
  install -Dm644 packaging/linux/duskytunesd.socket "$pkgdir/usr/lib/systemd/user/duskytunesd.socket"
  install -Dm644 packaging/linux/90-duskytunes.preset "$pkgdir/usr/lib/systemd/user-preset/90-duskytunes.preset"

  # Client QML files & skins
  install -dm755 "$pkgdir/usr/share/duskytunes/client"
  cp -r client/. "$pkgdir/usr/share/duskytunes/client/"
  rm -rf "$pkgdir/usr/share/duskytunes/client/tests"

  install -dm755 "$pkgdir/usr/share/duskytunes/skins"
  cp -r skins/. "$pkgdir/usr/share/duskytunes/skins/"

  install -Dm644 matugen/duskytunes.json "$pkgdir/usr/share/duskytunes/matugen/duskytunes.json"

  # Bundled Dusky.Ui design runtime
  if [[ -d "runtime/qml/Dusky/Ui" ]]; then
    install -dm755 "$pkgdir/usr/lib/qt6/qml/Dusky/Ui"
    cp -r runtime/qml/Dusky/Ui/. "$pkgdir/usr/lib/qt6/qml/Dusky/Ui/"
    find "$pkgdir/usr/lib/qt6/qml/Dusky/Ui" -type d -exec chmod 755 {} +
    find "$pkgdir/usr/lib/qt6/qml/Dusky/Ui" -type f -exec chmod 644 {} +

    install -dm755 "$pkgdir/usr/share/duskytunes/qml/Dusky/Ui"
    cp -r runtime/qml/Dusky/Ui/. "$pkgdir/usr/share/duskytunes/qml/Dusky/Ui/"
    find "$pkgdir/usr/share/duskytunes/qml/Dusky/Ui" -type d -exec chmod 755 {} +
    find "$pkgdir/usr/share/duskytunes/qml/Dusky/Ui" -type f -exec chmod 644 {} +
  fi

  # Desktop file and metadata
  install -Dm644 packaging/linux/duskytunes.desktop "$pkgdir/usr/share/applications/duskytunes.desktop"
  install -Dm644 packaging/linux/dev.dusky.duskytunes.metainfo.xml "$pkgdir/usr/share/metainfo/dev.dusky.duskytunes.metainfo.xml"

  # Icons
  for s in 32x32 64x64 128x128; do
    install -Dm644 "src-tauri/icons/${s}.png" "$pkgdir/usr/share/icons/hicolor/${s}/apps/duskytunes.png"
  done
  install -Dm644 src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/duskytunes.png"
  install -Dm644 src-tauri/icons/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/duskytunes.png"

  # Documentation and license
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
